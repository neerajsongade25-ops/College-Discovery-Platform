# Backend Environment Variables — copy to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/college_discovery"

# Server port
PORT=5000

# Environment
NODE_ENV=development

# Frontend URL for CORS (set to your Vercel/Netlify URL in production)
FRONTEND_URL=http://localhost:3000

# Your Render backend URL — used for self-ping keep-alive in production.
# Render sets this automatically as RENDER_EXTERNAL_URL, but you can override.
# Example: https://college-api.onrender.com
RENDER_EXTERNAL_URL=
